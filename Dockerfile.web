FROM node:24-alpine AS frontend
WORKDIR /build
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ .
RUN npm run build

FROM node:24-alpine AS studio
WORKDIR /build
COPY vendor/scormly/package*.json ./
RUN npm ci
COPY vendor/scormly/ .
RUN npm run build -- --base=/studio/

FROM nginx:stable-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=frontend /build/dist /usr/share/nginx/html
COPY --from=studio /build/dist /usr/share/nginx/html/studio
EXPOSE 80 81
