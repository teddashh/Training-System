# Local Docker demonstration. Use HTTPS + DEBUG=false for a production deployment.
DEBUG=true
DEMO_MODE=true
SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_PASSWORD=replace-with-a-url-safe-random-password
ALLOWED_HOSTS=localhost,127.0.0.1,api,content
APP_ORIGIN=http://localhost:8080
# Optional mount path, e.g. /training. APP_ORIGIN stays a scheme + host.
APP_BASE_PATH=
SCORM_ORIGIN=http://localhost:8081
# For reviewed organization packages only: set true and SCORM_ORIGIN=APP_ORIGIN.
# Serves content at APP_BASE_PATH/content; only administrators may upload SCORM.
SCORM_TRUSTED_SAME_ORIGIN=false

# Leave sign-in credentials empty to configure the provider in Settings.
# Single-tenant Microsoft Entra application (Web redirect URI).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Google Web application; non-empty credentials lock sign-in to the server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required exact Workspace domains, comma-separated, for Google sign-in.
GOOGLE_WORKSPACE_DOMAINS=
# Optional Fernet key; empty derives the settings key from SECRET_KEY.
# Preserve the effective key with backups. After changing it, re-enter saved secrets.
SETTINGS_ENCRYPTION_KEY=

# Email OTP login for provisioned accounts.
# Requests per 10 minutes from the direct proxy peer; account limit remains 20.
AUTH_NETWORK_LIMIT=300
# Empty EMAIL_HOST and EMAIL_BACKEND use Settings (default: Off).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=training@example.com

# Optional Microsoft Graph mail transport. Use a separate app with Exchange
# Application Mail.Send scoped to only GRAPH_MAIL_SENDER, not tenant-wide access.
# Empty uses Settings; a non-empty backend locks e-mail to the server.
EMAIL_BACKEND=
GRAPH_MAIL_TENANT_ID=
GRAPH_MAIL_CLIENT_ID=
GRAPH_MAIL_CLIENT_SECRET=
GRAPH_MAIL_SENDER=

# Directory provisioning: app-only User.Read.All + owner-approved tenant admin consent.
# Each blank credential falls back to its GRAPH_MAIL_* counterpart.
# The directory tenant must match effective Entra sign-in. Prefer a separate app.
GRAPH_DIRECTORY_TENANT_ID=
GRAPH_DIRECTORY_CLIENT_ID=
GRAPH_DIRECTORY_CLIENT_SECRET=
DIRECTORY_REQUIRE_LICENSE=true
# Comma-separated approved email domains; empty means no domain filter.
DIRECTORY_EMAIL_DOMAINS=
# 0 = manual only. Positive hours enable the existing scheduler.
DIRECTORY_SYNC_INTERVAL_HOURS=0
# Keep false to require Microsoft sign-in, except for learners in EMAIL_CODE_DOMAINS.
EMAIL_CODE_FOR_ENTRA_USERS=false
# Exact email domains allowing learner codes and on-demand directory accounts; empty disables.
EMAIL_CODE_DOMAINS=
# Transactional learning notifications; authentication email remains synchronous.
EMAIL_NOTIFICATIONS_ENABLED=true
EMAIL_QUEUE_BATCH=20
# Accepted platform messages in a rolling 24 hours; 0 disables. Codes/tests bypass.
EMAIL_DAILY_LIMIT=5000
NOTIFICATION_TIME_ZONE=America/New_York

# Deployment brand folder under shared/brand; lowercase letters, digits and hyphens.
# The pack must exist. Rebuild both application images when changing BRAND.
BRAND=default
# Allowed interface languages, in default-first order (en, zh-TW, es).
# Empty uses Settings (default: all three); non-empty is read-only in the app.
# Unknown codes are ignored; none valid means en.
# Example: INTERFACE_LANGUAGES=en
INTERFACE_LANGUAGES=
