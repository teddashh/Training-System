# Local Docker demonstration. Use HTTPS + DEBUG=false for a company deployment.
DEBUG=true
DEMO_MODE=true
SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_PASSWORD=replace-with-a-url-safe-random-password
ALLOWED_HOSTS=localhost,127.0.0.1,api,content
APP_ORIGIN=http://localhost:8080
SCORM_ORIGIN=http://localhost:8081

# Single-tenant Microsoft Entra application (Web redirect URI).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Email OTP login for provisioned accounts.
# Requests per 10 minutes from the direct proxy peer; account limit remains 20.
AUTH_NETWORK_LIMIT=300
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=training@example.com
